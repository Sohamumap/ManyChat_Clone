# Copy to .env (or run ./deploy/init-env.sh, which fills in random secrets for you)

# ---------------------------------------------------------------- domain & HTTPS
# Your free DuckDNS name (see docs/DEPLOY_AWS.md). Caddy gets the HTTPS certificate itself.
# On your own computer use DOMAIN=:80 and PUBLIC_BASE_URL=http://localhost
DOMAIN=yourname.duckdns.org
PUBLIC_BASE_URL=https://yourname.duckdns.org

# ---------------------------------------------------------------- secrets
# Long random strings: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=

# Dashboard login (created on first start; change the password later in Settings)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------- Instagram / Meta app
# Meta App Dashboard -> Instagram -> API setup with Instagram login -> "Instagram app ID/secret"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: Meta App Dashboard -> App settings -> Basic -> App secret
META_APP_SECRET=
# Any random string; paste the same value into the webhook "Verify token" field in Meta
WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v26.0

# ---------------------------------------------------------------- optional
# Keep the DuckDNS name pointed at this server if its IP changes (deploy/duckdns-update.sh)
DUCKDNS_TOKEN=
